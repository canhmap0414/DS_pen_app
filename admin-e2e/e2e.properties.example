# Copy to e2e.properties and fill in an existing admin account
# (create one with backend/cmd/createadmin). Env vars / -D flags override these.
E2E_BASE_URL=http://localhost:5173
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=change-me
HEADLESS=true
# Optional: a locked account for login cases 35-36 (skipped when empty).
# The admin UI cannot lock users yet, so set status = 'locked' in the users table.
E2E_LOCKED_EMAIL=
E2E_LOCKED_PASSWORD=
